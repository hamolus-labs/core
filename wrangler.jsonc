{
  // Cloudflare Worker — the Hamolus core API.
  // Dev: `pnpm -F @hamolus/core dev` · Bundle check: `pnpm -F @hamolus/core build`
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamolus-core",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 database (records + collection metadata).
  // The ids below are PLACEHOLDERS: create your own resources and paste the real
  // ids, or use a generated deployment configuration instead:
  //   hamolus add configuration <name>   →   configs/<name>/wrangler.jsonc
  // which ships the same bindings with a `verify.mjs` that reports leftover placeholders.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamolus"
    }
  ],

  // KV namespace (settings blob: settings:v1)
  "kv_namespaces": [
    {
      "binding": "SETTINGS"
    }
  ],

  // R2 bucket (media + file objects)
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hamolus-media"
    }
  ],

  // Declared, not defaulted-in-code.
  //
  // `Env` reads all four with a fallback, so leaving them out works and looks like it
  // works — and that is the problem: the Cloudflare dashboard then shows no such
  // variables at all, so there is nothing to inspect or change without editing this
  // file. Declaring them changes no behaviour; it makes the effective scope visible.
  //
  // `default` is the reserved sentinel for "the unnamed scope", not the name of a land
  // called `default`: `scopeNameSchema` rejects it as a reserved name, so `scope.ts`
  // falls through to `root_lnd` / `root_cny`. That is what `hamolus create` writes into
  // a generated core too, so the two agree — but it is why a real name here is what
  // actually moves a deployment onto a named land.
  //
  // Land and colony are *names* here, not `*_lnd` / `*_cny` ids.
  "vars": {
    // Multi-tenant mode: independent | centralized | proxy | bridge
    "CORE_MODE": "independent",

    // Land used by bare (unprefixed) tenant requests.
    "DEFAULT_LAND": "default",

    // Colony used by bare requests and by `x-land`-only (land admin) requests.
    "DEFAULT_COLONY": "default",

    // PUBLIC_GETS=true lets the generated console read collections/settings without
    // a token (GET only); writes and /api/_auth/* always require a session.
    //
    // Read that as "every unauthenticated GET on this worker answers". Set it to
    // "false" for anything public-facing and hand out scoped tokens instead.
    "PUBLIC_GETS": "false"
  }

  // Credentials (JWT_SECRET, ADMIN_KEY, PANEL_ASSET_SECRET, SUPER_ADMIN_USERNAME /
  // SUPER_ADMIN_PASSWORD) are SECRETS, never vars — a secret and a var cannot share a
  // name, and a committed config must not carry them:
  //   wrangler secret put JWT_SECRET
  //   wrangler secret put ADMIN_KEY
}
